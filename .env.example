# Não é lido pelo código hoje: use `npm run run -- --input <pasta> --output <pasta>`.
# Nenhuma chave de API é necessária (o pipeline não chama modelo de IA).

# Configurações do Fechamento Tarvo (Underdogs)

# Diretório base dos dados (padrão: docs/Tarvo_Data_Pack_set2026)
DATA_PACK_DIR=docs/Tarvo_Data_Pack_set2026

# Diretório de saída dos relatórios (padrão: saida)
OUTPUT_DIR=saida

# Reservado; nenhuma chamada de IA existe em src/.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Nível de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
